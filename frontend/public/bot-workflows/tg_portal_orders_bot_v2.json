      "parameters": {
        "jsCode": "const update = $input.first().json;\nconst message = update.message ?? update.callback_query?.message;\nconst callbackData = update.callback_query?.data ?? '';\nconst text = (update.message?.text ?? '').trim();\nconst chatId = message?.chat?.id;\nif (!chatId) throw new Error('Telegram chat id is missing');\nconst statusByText = {'?? ????':'new','? ???????? ?????????????':'awaiting_confirmation','?? ???????? ??????':'awaiting_payment','?? ? ???????????':'production','?? ??????????':'delayed','? ??????':'ready'};\nlet action = 'help', userGuid = '', status = statusByText[text] ?? 'all', orderId = '', orderNumber = '', linkedOrderNumber = '';\nif (text.startsWith('/start')) { action = 'start'; userGuid = text.replace('/start','').trim(); }\nelse if (callbackData.startsWith('confirm|')) { action = 'confirm'; [,orderId,orderNumber,linkedOrderNumber=''] = callbackData.split('|'); }\nelse if (text === '?? ???? ?? ????????') action = 'daily';\nelse if (text === '?? ??? ??????????' || status !== 'all') action = 'orders';\nelse if (text === '?? ??????? ????' || text === '/menu') action = 'menu';\nreturn [{json:{action,chat_id:chatId,user_guid:userGuid,status,order_id:orderId,order_number:orderNumber,linked_order_number:linkedOrderNumber}}];"
      },
