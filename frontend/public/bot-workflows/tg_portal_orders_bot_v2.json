        "jsCode": "const orders = $json.orders ?? [];\nconst labels = {new:'????',awaiting_confirmation:'???????? ?????????????',awaiting_payment:'???????? ??????',production:'? ???????????',delayed:'??????????',ready:'??????'};\nconst money = value => new Intl.NumberFormat('uk-UA',{maximumFractionDigits:2}).format(Number(value || 0));\nconst rows = orders.slice(0,20).map((o,i)=>`${i+1}. <b>?${o.number}</b>${o.linked_order_number ? ` (${o.linked_order_number})` : ''}\\n${o.status} ? ${money(o.amount)} ${o.currency} ? ${o.count} ?????????.`);\nconst inline = orders.filter(o => !/(????????????|????????????)/i.test(o.status)).slice(0,12).map(o=>[{text:`? ??????????? ?${o.number}`,callback_data:`confirm|${o.id}|${o.number}|${o.linked_order_number ?? ''}`}]);\nreturn [{json:{chat_id:$('Parse portal command').item.json.chat_id,text:`<b>${labels[$json.status] ?? '??? ??????????'}</b>\\n${rows.length ? rows.join('\\n\\n') : '?? ??????? ???????? ????????? ?????.'}`,reply_markup:inline.length ? {inline_keyboard:inline} : undefined}}];"
